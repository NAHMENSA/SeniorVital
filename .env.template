# ── GCP Configuration (for Firestore and BigQuery integration) ──
# Set DATA_CLIENT_MODE=gcp to use Firestore/BigQuery instead of PostgreSQL/DuckDB
DATA_CLIENT_MODE=local

# GCP Project ID (required for GCP mode)
GCP_PROJECT_ID=

# Path to GCP service account JSON credentials (required for GCP mode)
# DO NOT commit this file to version control
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset name
BIGQUERY_DATASET=seniorvital

# Firestore collection names
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_HABITS=habits

# DuckDB path for local analytics (used by BigQueryClient in local mode)
# DUCKDB_PATH=./seniorvital_analytics.duckdb
